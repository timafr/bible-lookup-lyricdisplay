{
  "name": "lyricdisplay-song-controller",
  "version": "1.0.0",
  "description": "Speech-assisted controller for lyrics already loaded in LyricDisplay.",
  "main": "main.js",
  "author": "Local ministry tool",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js && node --test tests/*.test.cjs",
    "build:win": "electron-builder --win --dir"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.biblelookup.lyricdisplay.songcontroller",
    "productName": "LyricDisplay Song Controller",
    "asar": true,
    "files": ["main.js", "preload.js", "renderer/**/*", "node_modules/**/*"],
    "win": { "target": [{ "target": "dir", "arch": ["x64"] }] },
    "directories": { "output": "dist" }
  }
}
